{
  "name": "ticklist-calendar",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "日历清单：月/周/列表/看板、独立 AI 对话，以及 macOS Apple 日历双向同步。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js", "client.js", "cordis.patch.yml", "app/", "sync/",
    "store.mjs", "ssh-backend.mjs", "remote-rpc.mjs",
    "native/CalendarBridge.swift", "native/Info.plist", "native/README.md", "native/test_bridge.py",
    "scripts/", "tests/", "locale/*.json", "icon.svg"
  ],
  "scripts": {
    "check": "node scripts/check.js",
    "test": "node --test tests/sync-*.test.js",
    "build:calendar": "bash scripts/build-calendar-bridge.sh",
    "install:calendar": "bash scripts/install-calendar-bridge.sh"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": [] }
  },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "calendar", "todo", "ticklist", "日历"],
  "author": "Leoguo",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/yzsuki-afk/ticklist-calendar.git" },
  "homepage": "https://github.com/yzsuki-afk/ticklist-calendar#readme",
  "bugs": { "url": "https://github.com/yzsuki-afk/ticklist-calendar/issues" }
}
